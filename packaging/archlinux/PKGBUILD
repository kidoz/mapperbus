# Maintainer: Aleksandr Pavlov <ckidoz@gmail.com>
pkgname=mapperbus
pkgver=0.1.0
pkgrel=1
pkgdesc='NES emulator with SDL3, CLI, and NodalKit GUI frontends'
arch=('x86_64')
url='https://github.com/kidoz/mapperbus'
license=('MIT')
depends=('gcc-libs' 'sdl3' 'wayland' 'libxkbcommon' 'freetype2' 'fontconfig' 'harfbuzz' 'glib2' 'vulkan-icd-loader')
makedepends=('git' 'meson' 'ninja' 'pkgconf' 'wayland-protocols' 'glslang' 'vulkan-headers')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    arch-meson build \
        -Denable_sdl3=true \
        -Denable_cli=true \
        -Denable_nodalkit_gui=true \
        -Dvulkan_shaders=enabled \
        -Denable_tests=false
    meson compile -C build
}

package() {
    cd "$pkgname-$pkgver"
    meson install -C build --destdir "$pkgdir" --no-rebuild --tags runtime

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
