#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std140, set = 2, binding = 0) uniform Params {
    int scale_factor;
    int src_width;
    int src_height;
    int padding;
};

layout(set = 0, binding = 0) uniform texture2D src;
layout(set = 0, binding = 1) uniform texture2D blend_info;
layout(rgba8, set = 1, binding = 0) uniform writeonly image2D dst;

// Evaluate the same footprint in coordinates reflected from each corner.
// Odd scales share their middle edge pixel between adjacent corners.
int corner_weight(int x, int y, int scale, int blend_type, bool enabled) {
    if (!enabled) return 0;
    if (x == 0 && y == 0) return 2;
    if ((x == 0 || y == 0) && 2 * x < scale && 2 * y < scale && blend_type == 2) return 1;
    return 0;
}

vec4 sample_src(int x, int y, int w, int h) {
    x = clamp(x, 0, w - 1);
    y = clamp(y, 0, h - 1);
    return texelFetch(src, ivec2(x, y), 0);
}

void main() {
    uvec3 gid = gl_GlobalInvocationID;
    int scale = scale_factor;
    int sw = src_width;
    int sh = src_height;
    int dw = sw * scale;
    int dh = sh * scale;
    if (int(gid.x) >= dw || int(gid.y) >= dh) return;

    int sx = int(gid.x) / scale;
    int sy = int(gid.y) / scale;
    int sub_x = int(gid.x) % scale;
    int sub_y = int(gid.y) % scale;
    vec4 H = sample_src(sx, sy, sw, sh);
    vec4 D = sample_src(sx-1, sy-1, sw, sh);
    vec4 F = sample_src(sx+1, sy-1, sw, sh);
    vec4 J = sample_src(sx-1, sy+1, sw, sh);
    vec4 L = sample_src(sx+1, sy+1, sw, sh);
    vec4 metadata = texelFetch(blend_info, ivec2(sx, sy), 0);
    int blends = int(round(metadata.r * 255.0));
    int active_corners = int(round(metadata.g * 255.0));
    // Sum exact eighths before converting to UNORM. This also keeps rounding
    // independent of the order in which overlapping corners are visited.
    ivec4 center = ivec4(round(H * 255.0));
    ivec4 result = center * 8;
    result += corner_weight(sub_x, sub_y, scale, (blends & 3), (active_corners & 1) != 0) *
              (ivec4(round(D * 255.0)) - center);
    result += corner_weight(scale - 1 - sub_x, sub_y,
                            scale, ((blends >> 2) & 3), (active_corners & 2) != 0) *
              (ivec4(round(F * 255.0)) - center);
    result += corner_weight(sub_x, scale - 1 - sub_y,
                            scale, ((blends >> 4) & 3), (active_corners & 4) != 0) *
              (ivec4(round(J * 255.0)) - center);
    result += corner_weight(scale - 1 - sub_x, scale - 1 - sub_y,
                            scale, ((blends >> 6) & 3), (active_corners & 8) != 0) *
              (ivec4(round(L * 255.0)) - center);
    imageStore(dst, ivec2(gid.xy), vec4(result) / (8.0 * 255.0));
}
