#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std140, set = 2, binding = 0) uniform Params {
    int scale_factor;
    int src_width;
    int src_height;
    int padding;
};

layout(set = 0, binding = 0) uniform texture2D src;
layout(set = 0, binding = 1) uniform texture2D blend_info;
layout(rgba8, set = 1, binding = 0) uniform writeonly image2D dst;

vec4 blend_3_1(vec4 a, vec4 b) {
    return mix(b, a, 0.75);
}

vec4 blend_7_1(vec4 a, vec4 b) {
    return mix(b, a, 0.875);
}

vec4 sample_src(int x, int y, int w, int h) {
    x = clamp(x, 0, w - 1);
    y = clamp(y, 0, h - 1);
    return texelFetch(src, ivec2(x, y), 0);
}

void main() {
    uvec3 gid = gl_GlobalInvocationID;
    int scale = scale_factor;
    int sw = src_width;
    int sh = src_height;
    int dw = sw * scale;
    int dh = sh * scale;
    if (int(gid.x) >= dw || int(gid.y) >= dh) return;

    int sx = int(gid.x) / scale;
    int sy = int(gid.y) / scale;
    int sub_x = int(gid.x) % scale;
    int sub_y = int(gid.y) % scale;
    vec4 H = sample_src(sx, sy, sw, sh);
    vec4 D = sample_src(sx-1, sy-1, sw, sh);
    vec4 F = sample_src(sx+1, sy-1, sw, sh);
    vec4 J = sample_src(sx-1, sy+1, sw, sh);
    vec4 L = sample_src(sx+1, sy+1, sw, sh);
    vec4 metadata = texelFetch(blend_info, ivec2(sx, sy), 0);
    int blends = int(round(metadata.r * 255.0));
    int active_corners = int(round(metadata.g * 255.0));
    float mid = float(scale) * 0.5;
    float px = float(sub_x);
    float py = float(sub_y);
    vec4 result = H;

    if (px < mid && py < mid && (active_corners & 1) != 0) {
        if (sub_x == 0 && sub_y == 0) {
            result = blend_3_1(H, D);
        } else if ((sub_x == 0 || sub_y == 0) && (blends & 3) == 2) {
            result = blend_7_1(H, D);
        }
    }
    if (px >= mid && py < mid && (active_corners & 2) != 0) {
        if (sub_x == scale-1 && sub_y == 0) {
            result = blend_3_1(H, F);
        } else if ((sub_x == scale-1 || sub_y == 0) && ((blends >> 2) & 3) == 2) {
            result = blend_7_1(H, F);
        }
    }
    if (px < mid && py >= mid && (active_corners & 4) != 0) {
        if (sub_x == 0 && sub_y == scale-1) {
            result = blend_3_1(H, J);
        } else if ((sub_x == 0 || sub_y == scale-1) && ((blends >> 4) & 3) == 2) {
            result = blend_7_1(H, J);
        }
    }
    if (px >= mid && py >= mid && (active_corners & 8) != 0) {
        if (sub_x == scale-1 && sub_y == scale-1) {
            result = blend_3_1(H, L);
        } else if ((sub_x == scale-1 || sub_y == scale-1) && ((blends >> 6) & 3) == 2) {
            result = blend_7_1(H, L);
        }
    }
    imageStore(dst, ivec2(gid.xy), result);
}
