--- a/src/joystick/meson.build	1970-01-01 03:00:00
+++ b/src/joystick/meson.build	2026-11-19 23:19:25
@@ -0,0 +1,25 @@
+if host_machine.system() == 'windows'
+  cdata.set('SDL_JOYSTICK_DINPUT', 1)
+  cdata.set('SDL_JOYSTICK_HIDAPI', 1)
+  subdir('hidapi')
+  subdir('windows')
+  subdir('gdk')
+elif host_machine.system() == 'darwin'
+  cdata.set('SDL_JOYSTICK_IOKIT', 1)
+  cdata.set('SDL_JOYSTICK_MFI', 1)
+  subdir('apple')
+  subdir('darwin')
+else
+  cdata.set('SDL_JOYSTICK_LINUX', 1)
+  subdir('linux')
+endif
+
+subdir('virtual')
+cdata.set('SDL_JOYSTICK_VIRTUAL', 1)
+
+sources += files(
+  'controller_type.c',
+  'SDL_gamepad.c',
+  'SDL_joystick.c',
+  'SDL_steam_virtual_gamepad.c',
+)
